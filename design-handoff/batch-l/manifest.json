    {
      "id": "L.16",
      "name": "AppClipCardScreen",
      "category": "platform-ios",
      "device": "iPhone 14",
      "stateNames": ["default", "loading", "success"]
    },
    {
      "id": "L.17",
      "name": "StoreScreenshotsScreen",
      "category": "marketing",
      "device": "iPhone 6.7\" + iPad 12.9\" + Pixel 7",
      "variantNames": ["iPhone-5-shots", "iPad-3-shots", "Android-5-shots"]
