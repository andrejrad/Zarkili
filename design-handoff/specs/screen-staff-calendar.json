{
  "source": {
    "batch": "G",
    "prompt": "G.2",
    "figmaFrames": [
      "G-2-default",
      "G-2-empty",
      "G-2-conflict",
      "G-2-loading",
      "G-2-error"
    ],
    "lockedAt": "2026-04-28",
    "primaryDevice": "iPad (768×1024)",
    "fallbackDevice": "iPhone 14 (390×844)"
  },
  "screen": "StaffCalendar",
  "version": "1.0.0",
  "device": {
    "primary": {
      "name": "iPad",
      "width": 768,
      "height": 1024,
      "safeArea": {
        "top": 24,
        "bottom": 24
      }
    },
    "fallback": {
      "name": "iPhone 14",
      "width": 390,
      "height": 844,
      "safeArea": {
        "top": 47,
        "bottom": 34
      }
    }
  },
  "description": "Staff calendar interface for viewing and managing daily/weekly appointments with time grid",
  "userPersona": "Authenticated staff member (stylist/technician)",
  "userJob": "View schedule, manage appointments, identify conflicts, book new slots",
  "states": {
    "default": {
      "description": "Normal day with appointments scheduled across various time slots"
    },
    "empty": {
      "description": "No appointments scheduled, shows encouragement and add CTA"
    },
    "conflict": {
      "description": "Overlapping appointments detected, red outline and alert banner"
    },
    "loading": {
      "description": "Loading appointments, skeleton blocks in grid"
    },
    "error": {
      "description": "Failed to load schedule, retry option"
    }
  },
  "layout": {
    "iPad": {
      "background": "#F2EDDD",
      "scrollable": true,
      "sections": [
        {
          "name": "header",
          "type": "sticky",
          "height": 80,
          "paddingHorizontal": 24,
          "background": "#F2EDDD",
          "borderBottom": {
            "width": 1,
            "color": "#E5E0D1"
          }
        },
        {
          "name": "calendarGrid",
          "type": "scrollable",
          "layout": "two-column",
          "leftColumn": {
            "name": "timeColumn",
            "width": 56,
            "background": "#FFFFFF",
            "borderRight": {
              "width": 1,
              "color": "#E5E0D1"
            }
          },
          "rightColumn": {
            "name": "appointmentArea",
            "flex": 1,
            "background": "#FFFFFF",
            "position": "relative"
          }
        },
        {
          "name": "peekPane",
          "type": "overlay",
          "width": 280,
          "position": "absolute",
          "right": 0,
          "height": "100%",
          "background": "#FFFFFF",
          "borderLeft": {
            "width": 1,
            "color": "#E5E0D1"
          },
          "visible": "{{onAppointmentTap}}"
        },
        {
          "name": "toolbar",
          "type": "fixed",
          "height": 72,
          "paddingHorizontal": 24,
          "background": "#FFFFFF",
          "borderTop": {
            "width": 1,
            "color": "#E5E0D1"
          },
          "bottom": 0
        }
      ]
    },
    "iPhone": {
      "background": "#F2EDDD",
      "scrollable": true,
      "viewMode": "day-only",
      "peekPane": "bottom-sheet-modal"
    }
  },
  "components": {
    "header": {
      "iPad": {
        "height": 80,
        "paddingHorizontal": 24,
        "structure": {
          "flexDirection": "row",
          "justifyContent": "space-between",
          "alignItems": "center"
        },
        "leftSection": {
          "flexDirection": "row",
          "alignItems": "center",
          "gap": 12
        },
        "todayButton": {
          "paddingHorizontal": 12,
          "paddingVertical": 6,
          "borderRadius": 8,
          "border": {
            "width": 1,
            "color": "#E5E0D1"
          },
          "background": "#FFFFFF",
          "label": {
            "content": "Today",
            "style": "label-small",
            "color": "#1A1A1A"
          },
          "onTap": "jumpToToday",
          "accessibility": {
            "role": "button",
            "label": "Jump to today"
          }
        },
        "dateDisplay": {
          "style": "heading-3",
          "color": "#1A1A1A",
          "format": "dddd, MMMM D"
        },
        "navButtons": {
          "flexDirection": "row",
          "gap": 8,
          "prevButton": {
            "icon": "chevron-left",
            "size": 24,
            "color": "#1A1A1A",
            "touchTarget": 44,
            "accessibilityLabel": "Previous day"
          },
          "nextButton": {
            "icon": "chevron-right",
            "size": 24,
            "color": "#1A1A1A",
            "touchTarget": 44,
            "accessibilityLabel": "Next day"
          }
        },
        "viewToggle": {
          "width": 160,
          "height": 40,
          "borderRadius": 12,
          "background": "#FFFFFF",
          "border": {
            "width": 1,
            "color": "#E5E0D1"
          },
          "segments": [
            {
              "id": "day",
              "label": "Day"
            },
            {
              "id": "week",
              "label": "Week"
            }
          ],
          "selectedSegment": {
            "background": "#E3A9A0",
            "label": {
              "color": "#FFFFFF"
            }
          },
          "unselectedSegment": {
            "background": "transparent",
            "label": {
              "color": "#6B6B6B"
            }
          }
        }
      },
      "iPhone": {
        "height": 56,
        "viewToggle": "hidden"
      }
    },
    "timeColumn": {
      "width": {
        "iPad": 56,
        "iPhone": 48
      },
      "background": "#FFFFFF",
      "borderRight": {
        "width": 1,
        "color": "#E5E0D1"
      },
      "timeRange": {
        "start": "5:00 AM",
        "end": "10:00 PM",
        "increment": 30,
        "unit": "minutes"
      },
      "rowHeight": 64,
      "hourLabels": {
        "style": "body-small",
        "color": "#6B6B6B",
        "format": "h A",
        "position": "top-aligned",
        "examples": ["5 AM", "6 AM", "7 AM", "8 AM", "9 AM", "10 AM", "11 AM", "12 PM", "1 PM", "2 PM", "3 PM", "4 PM", "5 PM", "6 PM", "7 PM", "8 PM", "9 PM", "10 PM"]
      },
      "totalHeight": "34 slots × 64px = 2176px"
    },
    "appointmentArea": {
      "flex": 1,
      "background": "#FFFFFF",
      "position": "relative",
      "gridLines": {
        "halfHour": {
          "height": 1,
          "color": "#F5F5F5",
          "interval": 64
        },
        "hour": {
          "height": 1,
          "color": "#E5E0D1",
          "interval": 128
        }
      },
      "scrollBehavior": {
        "vertical": true,
        "initialScroll": "current-time-minus-2-hours"
      }
    },
    "nowLine": {
      "position": "absolute",
      "width": "100%",
      "height": 2,
      "background": "#E3A9A0",
      "zIndex": 10,
      "topPosition": "{{calculateFromCurrentTime}}",
      "indicator": {
        "circle": {
          "size": 8,
          "background": "#E3A9A0",
          "position": "left"
        },
        "timeLabel": {
          "style": "label-small",
          "background": "#E3A9A0",
          "color": "#FFFFFF",
          "paddingHorizontal": 6,
          "paddingVertical": 2,
          "borderRadius": 4,
          "position": "left",
          "marginLeft": 4,
          "format": "h:mm A"
        }
      },
      "updateInterval": "1 minute"
    },
    "appointmentBlock": {
      "position": "absolute",
      "width": {
        "iPad": "calc(100% - 32px)",
        "iPhone": "calc(100% - 16px)"
      },
      "marginHorizontal": {
        "iPad": 16,
        "iPhone": 8
      },
      "borderRadius": 12,
      "padding": 12,
      "structure": {
        "borderLeft": {
          "width": 4,
          "color": "{{categoryColor}}"
        },
        "border": {
          "width": 1,
          "color": "{{categoryColor}}"
        },
        "background": "{{categoryColorAlpha10}}"
      },
      "content": {
        "time": {
          "style": "label-small",
          "fontWeight": 500,
          "color": "#1A1A1A",
          "format": "h:mm A"
        },
        "client": {
          "style": "body",
          "color": "#1A1A1A",
          "marginTop": 4
        },
        "service": {
          "style": "body-small",
          "color": "#6B6B6B",
          "marginTop": 2
        },
        "duration": {
          "style": "body-small",
          "color": "#6B6B6B",
          "format": "{{hours}}h {{minutes}}m"
        }
      },
      "dragHandles": {
        "top": {
          "height": 4,
          "width": "100%",
          "cursor": "ns-resize",
          "hoverIndicator": {
            "visible": true,
            "content": "3 dots",
            "color": "#6B6B6B"
          }
        },
        "bottom": {
          "height": 4,
          "width": "100%",
          "cursor": "ns-resize",
          "hoverIndicator": {
            "visible": true,
            "content": "3 dots",
            "color": "#6B6B6B"
          }
        }
      },
      "states": {
        "default": {
          "border": {
            "width": 1
          }
        },
        "hover": {
          "cursor": "pointer",
          "opacity": 0.9
        },
        "selected": {
          "border": {
            "width": 2,
            "color": "#1A1A1A"
          }
        },
        "conflict": {
          "border": {
            "width": 2,
            "color": "#F44336"
          },
          "background": "rgba(244, 67, 54, 0.05)",
          "zIndex": 20
        }
      },
      "positioning": {
        "topCalculation": "((startTimeInMinutes - 5:00AM) / 30) × 64px",
        "heightCalculation": "(durationInMinutes / 30) × 64px"
      },
      "categoryColors": {
        "nails": {
          "border": "#E3A9A0",
          "background": "rgba(227, 169, 160, 0.1)"
        },
        "hair": {
          "border": "#D1BFB3",
          "background": "rgba(209, 191, 179, 0.1)"
        },
        "skin": {
          "border": "#BBEDDA",
          "background": "rgba(187, 237, 218, 0.1)"
        },
        "lashes": {
          "border": "#2196F3",
          "background": "rgba(33, 150, 243, 0.1)"
        },
        "massage": {
          "border": "#9C27B0",
          "background": "rgba(156, 39, 176, 0.1)"
        },
        "default": {
          "border": "#6B6B6B",
          "background": "rgba(107, 107, 107, 0.1)"
        }
      },
      "accessibility": {
        "role": "button",
        "label": "{{time}}, {{duration}}, {{service}} for {{client}}",
        "hint": "Tap to view details, drag edges to resize",
        "actions": [
          {
            "name": "resize",
            "label": "Adjust appointment time"
          }
        ]
      }
    },
    "peekPane": {
      "iPad": {
        "width": 280,
        "position": "absolute",
        "right": 0,
        "height": "100%",
        "background": "#FFFFFF",
        "borderLeft": {
          "width": 1,
          "color": "#E5E0D1"
        },
        "padding": 16,
        "slideAnimation": {
          "duration": 300,
          "easing": "ease-out",
          "from": "translateX(100%)",
          "to": "translateX(0)"
        }
      },
      "iPhone": {
        "type": "bottom-sheet",
        "height": "auto",
        "maxHeight": "80%",
        "borderRadiusTop": 24,
        "padding": 16
      },
      "structure": {
        "closeButton": {
          "position": "absolute",
          "top": 16,
          "right": 16,
          "icon": "x",
          "size": 24,
          "color": "#6B6B6B",
          "touchTarget": 44,
          "accessibilityLabel": "Close details"
        },
        "timeRange": {
          "style": "heading-4",
          "color": "#1A1A1A",
          "format": "h:mm A - h:mm A"
        },
        "clientSection": {
          "marginTop": 16,
          "avatar": {
            "size": 40,
            "borderRadius": 9999,
            "marginRight": 12
          },
          "name": {
            "style": "body",
            "color": "#1A1A1A"
          },
          "phone": {
            "style": "body-small",
            "color": "#6B6B6B",
            "format": "(XXX) XXX-XXXX"
          }
        },
        "serviceSection": {
          "marginTop": 16,
          "service": {
            "style": "body",
            "color": "#1A1A1A"
          },
          "duration": {
            "style": "body-small",
            "color": "#6B6B6B",
            "format": "{{hours}} hour {{minutes}} minutes"
          },
          "price": {
            "style": "body",
            "color": "#1A1A1A",
            "format": "${{amount}}"
          }
        },
        "notesSection": {
          "marginTop": 16,
          "label": {
            "content": "NOTES",
            "style": "label-small",
            "textTransform": "uppercase",
            "color": "#6B6B6B"
          },
          "text": {
            "style": "body-small",
            "color": "#6B6B6B",
            "marginTop": 4
          }
        },
        "actions": {
          "marginTop": 24,
          "gap": 8,
          "editButton": {
            "width": "100%",
            "height": 44,
            "borderRadius": 12,
            "background": "#F5F5F5",
            "label": {
              "content": "Edit",
              "style": "label",
              "color": "#1A1A1A"
            }
          },
          "cancelButton": {
            "width": "100%",
            "height": 44,
            "background": "transparent",
            "label": {
              "content": "Cancel appointment",
              "style": "label-small",
              "color": "#F44336"
            }
          }
        }
      }
    },
    "toolbar": {
      "iPad": {
        "height": 72,
        "paddingHorizontal": 24,
        "background": "#FFFFFF",
        "borderTop": {
          "width": 1,
          "color": "#E5E0D1"
        },
        "structure": {
          "flexDirection": "row",
          "justifyContent": "space-between",
          "alignItems": "center"
        },
        "leftSection": {
          "flexDirection": "row",
          "alignItems": "center",
          "gap": 24
        },
        "todayButton": {
          "label": {
            "content": "Today",
            "style": "label",
            "color": "#E3A9A0"
          },
          "touchTarget": 44,
          "accessibilityLabel": "Jump to today"
