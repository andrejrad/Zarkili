    "skeleton": {
      "shimmer": {
        "animation": {
          "duration": 1500,
          "easing": "ease-in-out",
          "iterations": "infinite",
          "gradient": "linear-gradient(90deg, #F5F5F5 0%, #E5E0D1 50%, #F5F5F5 100%)",
          "backgroundPosition": "-200% 0 to 200% 0"
        }
      },
      "appointmentBlock": {
        "width": "calc(100% - 32px)",
        "marginHorizontal": 16,
        "borderRadius": 12,
        "background": "#F5F5F5",
        "heights": [128, 192, 256],
        "randomPositions": true
      }
    }
  },
  "interactions": {
    "appointmentBlock": {
      "tap": "Open peek pane with details",
      "drag": "Move appointment to new time slot",
      "dragTopEdge": "Adjust start time",
      "dragBottomEdge": "Adjust end time",
      "longPress": "Show context menu (edit, cancel, duplicate)"
    },
    "emptySlot": {
      "tap": "Open new appointment form with pre-filled time"
    },
    "dateNavigation": {
      "chevronLeft": "Go to previous day",
      "chevronRight": "Go to next day",
      "todayButton": "Jump to today",
      "dateJump": "Open date picker modal"
    },
    "viewToggle": {
      "tap": "Switch between Day and Week views"
    }
  },
  "dataModel": {
    "appointment": {
      "id": "string",
      "startTime": "string (ISO 8601)",
      "endTime": "string (ISO 8601)",
      "duration": "number (minutes)",
      "client": {
        "id": "string",
        "name": "string",
        "phone": "string",
        "avatar": "string (URL)"
      },
      "service": {
        "id": "string",
        "name": "string",
        "category": "string (nails | hair | skin | lashes | massage | etc)",
        "price": "number",
        "duration": "number (minutes)"
      },
      "status": "string (confirmed | completed | cancelled | noShow)",
      "notes": "string"
    },
    "conflicts": [
      {
        "appointmentIds": ["string", "string"],
        "overlapStart": "string (ISO 8601)",
        "overlapEnd": "string (ISO 8601)"
      }
    ]
  },
  "usLocale": {
    "timeFormat": "12h (h:mm A)",
    "dateFormat": "dddd, MMMM D",
    "currency": "USD ($)",
    "phone": "(XXX) XXX-XXXX"
  },
  "accessibility": {
    "screenLabel": "Calendar view",
    "appointmentBlock": {
      "role": "button",
      "label": "{{time}}, {{duration}}, {{service}} for {{client}}",
      "hint": "Tap to view details, drag edges to resize",
      "actions": [
        {
          "name": "resize",
          "label": "Adjust appointment time"
        }
      ]
    },
    "nowLine": {
      "accessibilityLabel": "Current time {{time}}",
      "accessibilityElementsHidden": false
    },
    "gridLines": {
      "accessibilityElementsHidden": true
    },
    "peekPane": {
      "role": "dialog",
      "label": "Appointment details"
    },
    "reduceMotion": {
      "disablePeekPaneSlideAnimation": true,
      "disableShimmerAnimation": true,
      "fallbackToCrossFade": true
    }
  },
  "calculations": {
    "appointmentTopPosition": "((startTimeInMinutes - 300) / 30) × 64",
    "appointmentHeight": "(durationInMinutes / 30) × 64",
    "nowLinePosition": "((currentTimeInMinutes - 300) / 30) × 64",
    "note": "300 minutes = 5:00 AM start time"
  },
  "transitions": {
    "peekPaneSlide": {
      "duration": 300,
      "easing": "ease-out",
      "properties": ["transform"]
    },
    "appointmentDrag": {
      "duration": 0,
      "realtime": true
    },
    "appointmentResize": {
