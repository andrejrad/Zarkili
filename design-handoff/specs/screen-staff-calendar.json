          "width": 1,
          "color": "#BBEDDA"
        },
        "flexDirection": "row",
        "alignItems": "center",
        "gap": 8,
        "icon": {
          "name": "coffee",
          "size": 20,
          "color": "#2D4A42"
        },
        "text": {
          "content": "Enjoy your free day!",
          "style": "label-small",
          "color": "#2D4A42"
        }
      }
    },
    "errorState": {
      "width": 400,
      "height": 300,
      "position": "center",
      "textAlign": "center",
      "icon": {
        "name": "alert-circle",
        "size": 80,
        "color": "#F44336"
      },
      "title": {
        "style": "heading-2",
