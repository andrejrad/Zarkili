            "label": {
              "content": "New appointment",
              "style": "label",
              "color": "#FFFFFF"
            },
            "states": {
              "pressed": {
                "background": "#CF8B80"
              }
            }
          }
        }
      },
      "iPhone": {
        "type": "fab",
        "position": "fixed",
        "bottom": 16,
        "right": 16,
        "width": 56,
        "height": 56,
        "borderRadius": 28,
        "background": "#E3A9A0",
        "shadow": "0px 4px 12px rgba(227, 169, 160, 0.4)",
        "icon": {
          "name": "plus",
          "size": 24,
          "color": "#FFFFFF"
        }
      }
    },
    "conflictAlert": {
      "position": "absolute",
      "top": 16,
      "marginHorizontal": 24,
      "width": "calc(100% - 48px)",
      "borderRadius": 12,
      "background": "#FFF5F5",
      "border": {
        "width": 1,
        "color": "#F44336"
      },
      "padding": 12,
      "zIndex": 100,
