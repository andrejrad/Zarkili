        "label": {
          "style": "label-small",
          "color": "#FFFFFF",
          "content": "Resolve"
        }
      }
    },
    "emptyState": {
      "width": 400,
      "height": 300,
      "position": "center",
      "textAlign": "center",
      "icon": {
        "name": "calendar",
        "size": 80,
        "color": "#6B6B6B"
      },
      "title": {
        "style": "heading-2",
        "color": "#1A1A1A",
        "content": "No appointments today",
