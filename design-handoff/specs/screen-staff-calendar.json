      },
      "body": {
        "style": "body",
        "color": "#6B6B6B",
        "content": "Your schedule is clear. Time to relax or reach out to clients!",
        "marginTop": 8
      },
      "cta": {
        "paddingHorizontal": 20,
        "paddingVertical": 12,
        "borderRadius": 12,
        "background": "#E3A9A0",
        "marginTop": 24,
        "label": {
          "content": "+ Add appointment",
