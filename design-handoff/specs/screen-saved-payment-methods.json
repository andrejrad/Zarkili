{
  "screen": "SavedPaymentMethods",
  "batchId": "D.1",
  "description": "Lists all saved payment methods (cards + Apple Pay) for the signed-in consumer. Allows setting a default, editing, removing, and adding new cards.",
  "purpose": "Manage Stripe-backed payment instruments. Non-destructive UI — mutations are confirmed via a modal sheet.",
  "sourceFile": "src/app/payments/SavedPaymentMethodsScreen.tsx",
  "hierarchy": {
    "container": {
      "background": "#F2EDDD",
      "safeArea": true,
      "flex": 1
    },
    "scroll": {
      "type": "ScrollView",
      "contentContainerPadding": 16,
      "contentContainerGap": 12
    }
  },
  "sections": {
    "header": {
      "type": "fixed",
      "height": 56,
      "background": "#FFFFFF",
      "paddingHorizontal": 16,
      "paddingVertical": 12,
      "borderBottomWidth": 1,
      "borderBottomColor": "#E5E0D1",
      "layout": "row",
      "children": ["backButton", "titleLabel", "headerSpacer"]
    },
    "backButton": {
      "type": "iconButton",
      "glyph": "←",
      "size": 44,
      "color": "#1A1A1A",
      "optional": true,
      "accessibility": {
        "role": "button",
        "label": "Back"
      }
    },
    "titleLabel": {
      "type": "text",
      "content": "Payment methods",
      "style": "heading-3",
      "fontSize": 18,
      "lineHeight": 24,
      "fontWeight": "600",
      "color": "#1A1A1A",
      "textAlign": "center",
      "flex": 1
    },
    "headerSpacer": {
      "type": "view",
      "width": 44
    },
    "errorBanner": {
      "type": "banner",
      "variant": "error",
      "background": "#D9534F",
      "borderRadius": 8,
      "padding": 12,
      "optional": true,
      "showWhen": "errorMessage is set"
    },
    "applePayRow": {
      "type": "pressable",
      "height": 56,
      "background": "#FFFFFF",
      "borderRadius": 12,
      "borderWidth": 1,
      "borderColor": "#E5E0D1",
      "paddingHorizontal": 16,
      "layout": "row",
      "gap": 12,
      "children": ["applePayGlyph", "applePayLabel"],
      "states": {
        "available": {
          "opacity": 1,
          "borderColor": "#E5E0D1"
        },
        "unavailable": {
          "opacity": 0.45,
          "borderColor": "#E5E0D1"
        }
      },
      "accessibility": {
        "role": "button",
        "label": "Apple Pay",
        "stateWhenDisabled": "Apple Pay not available on this device"
      }
    },
    "applePayGlyph": {
      "type": "text",
      "content": "",
      "fontSize": 24,
      "color": "#1A1A1A"
    },
    "applePayLabel": {
      "type": "text",
      "style": "body",
      "fontSize": 16,
      "fontWeight": "500",
      "color": "#1A1A1A"
    },
    "loadingSkeleton": {
      "type": "skeleton",
      "count": 2,
      "height": 64,
      "borderRadius": 12,
      "background": "#E5E0D1",
      "showWhen": "loading === true"
    },
    "emptyState": {
      "type": "view",
      "gap": 12,
      "paddingVertical": 32,
      "alignItems": "center",
      "showWhen": "methods is empty and not loading",
      "children": ["emptyTitle", "emptyBody", "addFirstCardButton"]
    },
    "emptyTitle": {
      "type": "text",
      "content": "No saved cards yet",
      "style": "heading-3",
      "fontSize": 18,
      "fontWeight": "600",
      "color": "#1A1A1A"
    },
    "emptyBody": {
      "type": "text",
      "content": "Add your first card to speed up checkout.",
      "style": "body",
      "fontSize": 14,
      "lineHeight": 20,
      "color": "#6B6B6B"
    },
    "addFirstCardButton": {
      "type": "button",
      "variant": "primary",
      "label": "Add your first card"
    },
    "paymentMethodList": {
      "type": "list",
      "showWhen": "methods is non-empty and not loading",
      "itemComponent": "PaymentMethodRow",
      "gap": 8
    },
    "addPaymentMethodTile": {
      "type": "pressable",
      "height": 56,
      "background": "transparent",
      "borderRadius": 12,
      "borderWidth": 1,
      "borderColor": "#E5E0D1",
      "borderStyle": "dashed",
      "paddingHorizontal": 16,
      "layout": "row",
      "gap": 8,
      "showWhen": "methods is non-empty",
      "children": ["addGlyph", "addLabel"],
      "accessibility": {
        "role": "button",
        "label": "Add payment method"
      }
    },
    "addGlyph": {
      "type": "text",
      "content": "+",
      "fontSize": 22,
      "color": "#6B6B6B"
    },
    "addLabel": {
      "type": "text",
      "content": "Add payment method",
      "fontSize": 16,
      "fontWeight": "500",
      "color": "#6B6B6B"
    }
  },
  "overlays": {
    "cardActionsMenu": {
      "type": "ModalSheet",
      "title": "Card actions",
      "trigger": "kebab menu on PaymentMethodRow",
      "items": [
        { "label": "Edit", "action": "onPressEdit" },
        { "label": "Set as default", "action": "onPressSetDefault" },
        { "label": "Remove", "action": "opens confirmRemoveSheet", "destructive": true }
      ]
    },
    "confirmRemoveSheet": {
      "type": "ModalSheet",
      "title": "Remove this card?",
      "body": "You can always add it back later. This won't cancel any in-progress bookings.",
      "footer": {
        "layout": "row",
        "gap": 8,
        "children": [
          { "component": "Button", "variant": "tertiary", "label": "Cancel", "fullWidth": true },
          { "component": "Button", "variant": "destructive", "label": "Remove", "fullWidth": true }
        ]
      }
    }
  },
  "tokens": {
    "background": "#F2EDDD",
    "surface": "#FFFFFF",
    "border": "#E5E0D1",
    "foreground": "#1A1A1A",
    "textMuted": "#6B6B6B",
    "primary": "#E3A9A0",
    "error": "#D9534F",
    "pageHorizontalPadding": 16,
    "cornerRadius": { "sm": 8, "md": 12, "lg": 16, "full": 9999 }
  },
  "interactions": {
    "tapApplePay": "calls onPressAddCard (Apple Pay sheet handled by caller)",
    "tapPaymentMethod": "calls onPressMethod(id) if provided",
    "tapKebab": "opens cardActionsMenu sheet for that method.id",
    "tapEdit": "calls onPressEdit(id)",
    "tapSetDefault": "calls onPressSetDefault(id)",
    "tapRemove": "opens confirmRemoveSheet",
    "confirmRemove": "calls onPressRemove(id)",
    "tapAddTile": "calls onPressAddCard"
  },
  "accessibility": {
    "screenLabel": "Payment methods",
    "listRole": "list",
    "applePayDisabledHint": "Apple Pay not available on this device",
    "removeConfirmation": "Destructive action — confirm modal required before calling onPressRemove"
  }
}
