{
  "screen": "StaffProductivityScreen",
  "route": "/admin/analytics/staff",
  "description": "Per-staff performance metrics including utilisation, revenue, ratings, no-shows, and upsells",
  "platform": "admin-desktop",
  "dimensions": { "width": 1280, "contentWidth": "calc(1280 - 240px sidebar)" },
  "states": ["default", "loading", "empty", "error"],
  "accessibility": {
    "screenReaderLabel": "strings.staffProductivity.screenTitle",
    "semanticRoles": [
      { "element": "staffTable", "role": "table" },
      { "element": "chartCard", "role": "img" }
    ]
  },
  "rtl": "deferred",
  "darkMode": "deferred",
  "layout": {
    "header": {
      "component": "AdminHeader",
      "title": "strings.staffProductivity.title",
      "rightActions": [
        "DateRangePicker",
        { "component": "Dropdown", "label": "strings.staffProductivity.staffFilter", "default": "All Staff" },
        "Export SecondaryButton"
      ]
    },
    "body": {
      "padding": 24,
      "kpiRow": {
        "tiles": 4,
        "metrics": ["Team Avg Utilisation %", "Avg Revenue per Staff Member", "Team Avg Rating", "Team No-show Rate %"]
      },
      "staffTable": {
        "width": "full",
        "component": "DataTable",
        "sortable": true,
        "columns": ["Staff Photo+Name", "Appointments", "Utilisation % (progress bar inline)", "Revenue", "Avg Rating (star display)", "No-shows", "Upsell Rate %", "View Details (link)"]
      },
      "row3": {
        "layout": "2 columns equal",
        "left": { "component": "BarChartCard", "title": "Utilisation by Staff", "orientation": "horizontal", "sorted": "desc" },
        "right": { "component": "BarChartCard", "title": "Revenue by Staff", "orientation": "horizontal", "sorted": "desc" }
      }
    }
  },
  "components": [
    { "id": "staffTable", "ref": "DataTable", "props": { "columns": "{{staffColumns}}", "data": "{{staffData}}", "sortable": true } },
    { "id": "utilisationChart", "ref": "BarChartCard", "props": { "title": "strings.staffProductivity.chartUtilisation", "orientation": "horizontal", "data": "{{utilisationData}}" } }
  ],
  "strings": "See strings/en-us.json for staffProductivity keys"
}
