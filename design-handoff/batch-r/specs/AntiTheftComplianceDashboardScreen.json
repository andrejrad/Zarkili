{
  "screen": "AntiTheftComplianceDashboardScreen",
  "route": "/admin/compliance/anti-theft",
  "description": "Admin dashboard for detecting and investigating suspicious staff transaction patterns",
  "platform": "admin-desktop",
  "dimensions": { "width": 1280, "contentWidth": "calc(1280 - 240px sidebar)" },
  "states": ["default", "loading", "empty", "error", "investigating"],
  "accessibility": {
    "screenReaderLabel": "strings.antiTheft.screenTitle",
    "semanticRoles": [
      { "element": "riskSummaryBar", "role": "region" },
      { "element": "flaggedTable", "role": "table" },
      { "element": "confirmedTable", "role": "table" }
    ]
  },
  "rtl": "deferred",
  "darkMode": "deferred",
  "layout": {
    "header": {
      "component": "AdminHeader",
      "title": "strings.antiTheft.title",
      "rightActions": [{ "component": "SecondaryButton", "label": "strings.antiTheft.exportButton" }, "DateRangePicker"]
    },
    "body": {
      "padding": 24,
      "riskSummaryBar": {
        "layout": "3-column card",
        "height": 120,
        "columns": [
          { "label": "strings.antiTheft.kpiSignals", "tint": "orange when > 0" },
          { "label": "strings.antiTheft.kpiConfirmed", "tint": "red when > 0" },
          { "label": "strings.antiTheft.kpiAtRisk", "tint": "amber when > 0" }
        ],
        "allZeroState": { "tint": "green", "message": "strings.antiTheft.allClear" }
      },
      "row2": {
        "layout": "2 columns equal",
        "left": {
          "component": "BarChartCard",
          "title": "strings.antiTheft.chartAnomalyTypes",
          "orientation": "horizontal",
          "categories": ["no-show fraud", "refund cluster", "discount abuse", "after-hours payment", "invoice tampering", "other"]
        },
        "right": { "component": "LineChartCard", "title": "strings.antiTheft.chartOverTime" }
      },
      "flaggedTable": {
        "width": "full",
        "component": "DataTable",
        "title": "strings.antiTheft.flaggedTableTitle",
        "columns": [
          "strings.antiTheft.columnDate",
          "strings.antiTheft.columnStaff",
          "strings.antiTheft.columnClient",
          "strings.antiTheft.columnType",
          "strings.antiTheft.columnAmount",
          "strings.antiTheft.columnRiskScore (0-100 inline color bar)",
          "strings.antiTheft.columnStatus (antiTheft.* badge: clean/suspicious/confirmed)",
          "Actions (Investigate, Escalate, Dismiss)"
        ]
      },
      "confirmedTable": {
        "width": "full",
        "title": "strings.antiTheft.confirmedTableTitle",
        "collapsible": true,
        "component": "DataTable",
        "columns": [
          "Staff Name",
          "strings.antiTheft.columnIncidentType",
          "strings.antiTheft.columnDate",
          "strings.antiTheft.columnAmount",
          "strings.antiTheft.columnResolution",
          "Actions (View Report)"
        ]
      }
    }
  },
  "components": [
    { "id": "flaggedTable", "ref": "DataTable", "props": { "title": "strings.antiTheft.flaggedTableTitle", "data": "{{flaggedTransactions}}" } },
    { "id": "confirmedTable", "ref": "DataTable", "props": { "title": "strings.antiTheft.confirmedTableTitle", "collapsible": true, "data": "{{confirmedIncidents}}" } }
  ],
  "strings": "See strings/en-us.json for antiTheft keys"
}
