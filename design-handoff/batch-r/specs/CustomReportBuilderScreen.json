{
  "screen": "CustomReportBuilderScreen",
  "route": "/admin/analytics/report-builder",
  "description": "Drag-and-drop tool for building named custom reports from widget palette",
  "platform": "admin-desktop",
  "dimensions": { "width": 1280, "contentWidth": "calc(1280 - 240px sidebar)" },
  "states": ["empty-canvas", "editing", "widget-selected", "preview", "saving"],
  "accessibility": {
    "screenReaderLabel": "strings.customReport.screenTitle",
    "semanticRoles": [
      { "element": "canvas", "role": "application" },
      { "element": "palette", "role": "list" }
    ]
  },
  "rtl": "deferred",
  "darkMode": "deferred",
  "layout": {
    "header": {
      "component": "AdminHeader",
      "title": "strings.customReport.title",
      "rightActions": [
        { "component": "SecondaryButton", "label": "strings.customReport.saveReport", "disabled": "when no widgets" },
        { "component": "SecondaryButton", "label": "strings.customReport.scheduleReport" },
        { "component": "PrimaryButton", "label": "strings.customReport.previewExport", "disabled": "when no widgets" }
      ]
    },
    "body": {
      "layout": "full-height two-panel, no outer scroll",
      "leftPalette": {
        "width": 260,
        "bg": "semantic.surface",
        "borderRight": "semantic.cardBorder",
        "title": "strings.customReport.paletteTitle",
        "categories": [
          { "label": "strings.customReport.categoryCharts", "widgets": ["Line", "Bar", "Funnel", "Cohort"] },
          { "label": "strings.customReport.categoryKpis", "widgets": [] },
          { "label": "strings.customReport.categoryTables", "widgets": [] },
          { "label": "strings.customReport.categoryText", "widgets": ["Text Block"] }
        ]
      },
      "rightCanvas": {
        "fills": true,
        "bg": "report.canvas.bg",
        "overflowY": "auto",
        "component": "ReportBuilderCanvas",
        "emptyState": { "title": "strings.customReport.emptyCanvasTitle", "subtitle": "strings.customReport.emptyCanvasSubtitle" }
      },
      "configPopover": {
        "fields": ["title input", "data source dropdown", "date override DateRangePicker", "Delete button"]
      }
    }
  },
  "components": [
    { "id": "reportCanvas", "ref": "ReportBuilderCanvas", "props": { "widgets": "{{widgets}}", "onWidgetAdd": "{{onWidgetAdd}}", "onWidgetMove": "{{onWidgetMove}}", "onWidgetResize": "{{onWidgetResize}}", "onWidgetRemove": "{{onWidgetRemove}}", "onSave": "{{onSave}}" } }
  ],
  "strings": "See strings/en-us.json for customReport keys"
}
