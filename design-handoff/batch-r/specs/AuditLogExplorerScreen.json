{
  "screen": "AuditLogExplorerScreen",
  "route": "/admin/audit",
  "description": "Searchable, filterable audit log for all admin actions across the tenant",
  "platform": "admin-desktop",
  "dimensions": { "width": 1280, "contentWidth": "calc(1280 - 240px sidebar)" },
  "states": ["default", "loading", "empty", "row-expanded", "generating-export"],
  "accessibility": {
    "screenReaderLabel": "strings.auditLog.screenTitle",
    "semanticRoles": [
      { "element": "filterBar", "role": "search" },
      { "element": "logTable", "role": "table" },
      { "element": "detailDrawer", "role": "dialog" }
    ]
  },
  "rtl": "deferred",
  "darkMode": "deferred",
  "layout": {
    "header": {
      "component": "AdminHeader",
      "title": "strings.auditLog.title",
      "rightActions": [{ "component": "SecondaryButton", "label": "strings.auditLog.exportCsv" }]
    },
    "body": {
      "padding": 24,
      "filterBar": {
        "component": "AuditLogFilterBar",
        "filters": ["search text", "DateRangePicker", "actor dropdown", "entity-type dropdown", "action dropdown", "severity dropdown", "Reset link"]
      },
      "summaryStrip": {
        "height": 40,
        "bg": "admin.tableHeaderBg",
        "left": "[n] strings.auditLog.totalResults",
        "right": "Dismissible filter chips"
      },
      "logTable": {
        "component": "DataTable",
        "rowComponent": "AuditLogRow",
        "pageSize": 50,
        "columns": ["Timestamp", "Actor", "Action", "Entity", "Severity", "expand chevron"]
      },
      "pagination": { "component": "Pagination", "labels": { "prev": "strings.auditLog.prevPage", "next": "strings.auditLog.nextPage", "page": "strings.auditLog.pageLabel" } }
    },
    "detailDrawer": {
      "width": 560,
      "position": "right overlay",
      "header": { "title": "strings.auditLog.drawerTitle", "closeX": true },
      "sections": [
        { "label": "strings.auditLog.beforeLabel", "content": "diff view" },
        { "label": "strings.auditLog.afterLabel", "content": "diff view" },
        { "label": "strings.auditLog.ipAddress" },
        { "label": "strings.auditLog.sessionId" },
        { "label": "strings.auditLog.userAgent" }
      ],
      "footer": { "component": "SecondaryButton", "label": "strings.auditLog.copyJson" }
    }
  },
  "components": [
    { "id": "filterBar", "ref": "AuditLogFilterBar", "props": { "onChange": "{{onFilterChange}}" } },
    { "id": "logTable", "ref": "DataTable", "props": { "rowComponent": "AuditLogRow", "pageSize": 50, "data": "{{auditData}}" } }
  ],
  "strings": "See strings/en-us.json for auditLog keys"
}
