{
  "component": "CalendarGrid",
  "description": "Monthly calendar grid for selecting appointment dates with availability indicators",
  "purpose": "Allow users to browse and select available appointment dates while showing booking availability, holidays, and current date",
  "source": {
    "batch": "C",
    "screen": "C.3 Date Picker",
    "promotedFrom": "documentation/figma-prompts/BATCH_C_BOOKING_FLOW.md",
    "figmaFrame": "C-component-calendar-grid",
    "lockedAt": "2026-04-27"
  },
  "variants": {
    "view": {
      "options": ["month"],
      "default": "month"
    }
  },
  "states": {
    "default": {
      "description": "Calendar grid showing current month with various date states"
    }
  },
  "anatomy": {
    "container": {
      "width": "100%",
      "maxWidth": 390,
      "background": "#F2EDDD",
      "padding": 16,
      "gap": 16,
      "borderRadius": 0
    },
    "quickPickRow": {
      "flexDirection": "row",
      "gap": 4,
      "marginBottom": 16,
      "children": ["todayChip", "tomorrowChip", "weekendChip"]
    },
    "quickPickChip": {
      "background": "#E3A9A0",
      "color": "#FFFFFF",
      "paddingHorizontal": 12,
      "paddingVertical": 8,
      "borderRadius": 8,
      "style": "label-small",
      "accessibility": {
        "role": "button",
        "label": "{{chipLabel}}",
        "hint": "Tap to jump to {{chipLabel}}"
      }
    },
    "monthSwitcher": {
      "height": 44,
      "flexDirection": "row",
      "alignItems": "center",
      "justifyContent": "space-between",
      "marginBottom": 16,
      "children": ["previousMonthButton", "monthLabel", "nextMonthButton"]
    },
    "previousMonthButton": {
      "size": 44,
      "icon": "chevron-left",
      "iconSize": 24,
      "iconColor": "#1A1A1A",
      "accessibility": {
        "role": "button",
        "label": "Previous month",
        "hint": "Go to {{previousMonthName}}"
      }
    },
    "monthLabel": {
      "style": "heading-3",
      "color": "#1A1A1A",
      "textAlign": "center",
      "flex": 1,
      "content": "{{monthName}} {{year}}"
    },
    "nextMonthButton": {
      "size": 44,
      "icon": "chevron-right",
      "iconSize": 24,
      "iconColor": "#1A1A1A",
      "accessibility": {
        "role": "button",
        "label": "Next month",
        "hint": "Go to {{nextMonthName}}"
      }
    },
    "weekdayHeader": {
      "flexDirection": "row",
      "marginBottom": 0,
      "children": "7 weekday labels"
    },
    "weekdayLabel": {
      "width": 44,
      "height": 44,
      "style": "label-small",
      "color": "#6B6B6B",
      "textAlign": "center",
      "justifyContent": "center",
      "content": "Sun, Mon, Tue, Wed, Thu, Fri, Sat"
    },
    "calendarGrid": {
      "layout": "grid",
      "columns": 7,
      "rows": 6,
      "gap": 0,
      "children": "42 date cells (6 weeks)"
    },
    "dateCell": {
      "width": 44,
      "height": 44,
      "borderRadius": 0,
      "justifyContent": "center",
      "alignItems": "center",
      "position": "relative",
      "states": {
        "default": {
          "background": "transparent",
          "color": "#1A1A1A",
          "borderWidth": 0
        },
        "today": {
          "background": "transparent",
          "color": "#1A1A1A",
          "borderWidth": 1,
          "borderColor": "#E3A9A0"
        },
        "selected": {
          "background": "#E3A9A0",
          "color": "#FFFFFF",
          "borderWidth": 0
        },
        "disabled": {
          "opacity": 0.3,
          "pointerEvents": "none"
        },
        "pressed": {
          "background": "rgba(227, 169, 160, 0.1)",
          "transform": "scale(0.95)"
        }
      },
      "accessibility": {
        "role": "button",
        "label": "{{dayName}} {{monthName}} {{dayNumber}}, {{availability}}",
        "hint": "Tap to select this date",
        "examples": {
          "available": "Wednesday March 12, 6 slots available",
          "fullyBooked": "Sunday March 16, fully booked",
          "today": "Thursday March 20, today, 3 slots available"
        }
      }
    },
    "dateCellNumber": {
      "style": "label-small",
      "textAlign": "center"
    },
    "holidayIndicator": {
      "position": "absolute",
      "bottom": 8,
      "width": 2,
      "height": 2,
      "borderRadius": 9999,
      "background": "#BBEDDA",
      "description": "Small dot below date number indicating holiday"
    },
    "selectedDateInfo": {
      "marginTop": 16,
      "gap": 4,
      "children": ["selectedDateLabel", "availabilityLabel"]
    },
    "selectedDateLabel": {
      "style": "body",
      "color": "#1A1A1A",
      "content": "{{dayName}}, {{monthName}} {{dayNumber}}"
    },
    "availabilityLabel": {
      "style": "body-small",
      "color": "#6B6B6B",
      "content": "{{staffName}} has {{slotCount}} slots available"
    }
  },
  "tokens": {
    "colors": {
      "primary": "#E3A9A0",
      "accent": "#BBEDDA",
      "background": "#F2EDDD",
      "surface": "#FFFFFF",
      "foreground": "#1A1A1A",
      "muted": "#6B6B6B",
      "border": "#E5E0D1",
      "disabled": "#B0B0B0"
    },
    "typography": {
      "heading-3": "20px/28px weight 600",
      "body": "14px/20px weight 400",
      "body-small": "12px/16px weight 400",
      "label-small": "12px/16px weight 500"
    },
    "spacing": {
      "containerPadding": 16,
      "sectionGap": 16,
      "chipGap": 4,
      "cellSize": 44,
      "infoGap": 4
    },
    "borderRadius": {
      "chip": 8,
      "cell": 0
    }
  },
  "interactions": {
    "dateCellPress": {
      "action": "Select date and update selectedDateInfo",
      "haptic": "light",
      "animation": {
        "type": "scale",
        "duration": 100,
        "scale": 0.95
      }
    },
    "previousMonthPress": {
      "action": "Load previous month calendar",
      "haptic": "light",
      "animation": {
        "type": "slide",
        "direction": "right",
        "duration": 200
      }
    },
    "nextMonthPress": {
      "action": "Load next month calendar",
      "haptic": "light",
      "animation": {
        "type": "slide",
        "direction": "left",
        "duration": 200
      }
    },
    "quickPickPress": {
      "action": "Jump to date and select",
      "haptic": "medium"
    }
  },
  "accessibility": {
    "screenReaderAnnouncement": "Calendar for {{monthName}} {{year}}. Use swipe to navigate dates.",
    "minimumTouchTarget": "44x44 pt (met by all interactive cells)",
    "focusOrder": [
      "quickPickChips",
      "previousMonthButton",
      "nextMonthButton",
      "dateCells (row by row, left to right)"
    ],
    "reducedMotion": {
      "disableSlideTransitions": true,
      "disableScaleAnimation": true
    }
  },
  "implementation": {
    "dataStructure": {
      "month": "Date object for first day of month",
      "selectedDate": "Date object or null",
      "disabledDates": "Array of Date objects",
      "holidays": "Array of Date objects",
      "availabilityMap": "Map<dateString, {staffName, slotCount}>"
    },
    "example": "<CalendarGrid month={new Date(2026, 2, 1)} selectedDate={new Date(2026, 2, 20)} disabledDates={[new Date(2026, 2, 28)]} holidays={[new Date(2026, 2, 16)]} availabilityMap={{ '2026-03-20': { staffName: 'Sarah', slotCount: 6 } }} onDateSelect={(date) => handleDateSelection(date)} onMonthChange={(newMonth) => loadMonthData(newMonth)} />"
  },
  "dependencies": {
    "icons": [
      "chevron-left (24px)",
      "chevron-right (24px)"
    ],
    "tokens": [
      "colors.json",
      "typography.json",
      "spacing.json"
    ]
  }
}
