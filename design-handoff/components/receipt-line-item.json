{
  "component": "ReceiptLineItem",
  "batchId": "D.4",
  "description": "3-column row for a single receipt line. Left: description (wrapping body text) with optional modifier on second line. Centre: quantity label (hidden when qty === 1). Right: right-aligned, pre-formatted amount string.",
  "sourceFile": "src/shared/ui/ReceiptLineItem.tsx",
  "variants": {
    "hasModifier": {
      "options": [true, false],
      "default": false
    },
    "hasQuantity": {
      "options": [true, false],
      "note": "Quantity column visible only when quantity > 1"
    }
  },
  "layout": {
    "type": "row",
    "alignItems": "flex-start",
    "paddingVertical": 8,
    "gap": 12
  },
  "elements": {
    "descriptionColumn": {
      "type": "view",
      "flex": 1,
      "children": ["descriptionText", "modifierText"]
    },
    "descriptionText": {
      "type": "text",
      "content": "{description}",
      "fontSize": 14,
      "lineHeight": 20,
      "fontWeight": "400",
      "color": "#1A1A1A",
      "numberOfLines": null,
      "wraps": true
    },
    "modifierText": {
      "type": "text",
      "content": "{modifier}",
      "showWhen": "modifier is provided",
      "fontSize": 12,
      "lineHeight": 16,
      "fontWeight": "400",
      "color": "#6B6B6B",
      "marginTop": 2
    },
    "quantityText": {
      "type": "text",
      "content": "× {quantity}",
      "showWhen": "quantity > 1",
      "fontSize": 12,
      "lineHeight": 20,
      "fontWeight": "500",
      "color": "#6B6B6B",
      "textAlign": "right",
      "minWidth": 32
    },
    "amountText": {
      "type": "text",
      "content": "{amountLabel}",
      "description": "Pre-formatted by caller (e.g. '$45.00')",
      "fontSize": 14,
      "lineHeight": 20,
      "fontWeight": "500",
      "color": "#1A1A1A",
      "textAlign": "right",
      "minWidth": 80
    }
  },
  "tokens": {
    "foreground": "#1A1A1A",
    "textMuted": "#6B6B6B",
    "rowPaddingVertical": 8,
    "gap": 12,
    "descFontSize": 14,
    "modifierFontSize": 12,
    "qtyFontSize": 12,
    "amountFontSize": 14,
    "amountMinWidth": 80
  },
  "usage": {
    "screen": "ReceiptScreen (D.4) — items[] list inside servicesCard",
    "callerResponsibility": "Caller computes amountLabel = formatUsd(quantity * unitPriceUsd)"
  },
  "accessibility": {
    "rowRole": "none (informational content within a scrollable list)",
    "note": "Screen reader reads description + amountLabel as a continuous content region"
  }
}
