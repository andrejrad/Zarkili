{
  "schemaVersion": "1.0.0",
  "screenId": "M.3",
  "screenName": "TenantSettingsShellScreen",
  "route": "admin/settings",
  "designSystem": "Zarkili v1.0.0",
  "device": "iPad 768x1024",
  "engineeringStatus": "delivered",
  "description": "Master-detail settings shell providing sidebar navigation to all tenant configuration sections.",
  "layout": {
    "type": "master-detail",
    "padding": {
      "top": 24,
