      "title": "Settings",
      "subtext": "{{tenantName}}"
    },
    {
      "id": "settings-nav",
      "type": "nav-section-list",
      "title": null,
      "component": "MC.3",
      "items": [
        {
          "key": "business-profile",
          "icon": "building",
          "label": "Business profile",
          "badge": null
        },
        {
          "key": "brand",
          "icon": "palette",
          "label": "Brand & appearance",
          "badge": null
        },
        {
          "key": "tax",
          "icon": "receipt",
          "label": "Tax settings",
          "badge": null
        },
        {
          "key": "currency",
          "icon": "currency-dollar",
          "label": "Currency",
          "badge": null
        },
        {
          "key": "legal-docs",
          "icon": "document",
          "label": "Legal documents",
          "badge": "requiredDocsCount > 0 ? requiredDocsCount : null"
        },
        {
          "key": "domain",
          "icon": "globe",
          "label": "Domain",
          "badge": null
        },
        {
          "key": "notifications",
          "icon": "bell",
          "label": "Notification preferences",
          "badge": null
        }
      ]
    }
  ],
  "stateNames": [
    "default",
    "legalDocsRequired",
    "error"
