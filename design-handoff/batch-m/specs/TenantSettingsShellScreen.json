      "bottom": 40,
      "left": 32
    },
    "maxContentWidth": 960,
    "gap": 24,
    "sidebar": {
      "width": 280,
      "background": "admin.surface",
      "border": "admin.border"
    }
  },
  "sections": [
    {
      "id": "sidebar-header",
