{
  "name": "zarkili",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "dotenv -e .env.development -- node scripts/expo-start.mjs",
    "start:prod": "dotenv -e .env.production -- node scripts/expo-start.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:smoke:web": "jest --watch=false --runInBand --runTestsByPath src/app/navigation/__tests__/AppNavigatorShell.webRouting.test.tsx",
    "test:smoke:native": "jest --watch=false --runInBand --runTestsByPath src/app/navigation/__tests__/AppNavigatorShell.test.tsx",
    "test:rules": "firebase emulators:exec --only firestore \"jest --config jest.rules.config.js --runInBand --runTestsByPath __tests__/firestore.rules.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm run test -- --watch=false",
    "build:web:dev": "dotenv -e .env.development -- npx expo export --platform web --clear",
    "build:web:prod": "dotenv -e .env.production -- npx expo export --platform web --clear",
    "copy:static": "node -e \"const fs=require('fs');const path=require('path');const src='public-static';const dst='dist';if(!fs.existsSync(dst))fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));console.log('Static files copied to dist/')\"",
    "deploy:web:dev": "npm run build:web:dev && npm run copy:static && firebase deploy --only hosting --project zarkili-dev",
    "deploy:web:prod": "npm run build:web:prod && npm run copy:static && firebase deploy --only hosting --project zarkili-production",
    "firebase:emulators": "firebase emulators:start --project zarkili-dev",
    "firebase:deploy:dev": "firebase deploy --project zarkili-dev",
    "firebase:deploy:prod": "firebase deploy --project zarkili-production",
    "seed:discovery:dev": "dotenv -e .env.development -- node scripts/seed-discovery-featured-salons.mjs",
    "seed:qa:dev": "dotenv -e .env.development -- node scripts/seed-qa-firestore.mjs",
    "seed:qa:dev:dry": "DRY_RUN=true dotenv -e .env.development -- node scripts/seed-qa-firestore.mjs",
    "seed:qa:dev:clear": "CLEAR_SEED=true dotenv -e .env.development -- node scripts/seed-qa-firestore.mjs",
    "seed:demo:dev": "dotenv -e .env.development -- node scripts/seed-demo-services.mjs",
    "seed:demo:dev:dry": "cross-env DRY_RUN=true dotenv -e .env.development -- node scripts/seed-demo-services.mjs",
    "seed:demo:dev:clear": "cross-env CLEAR_SEED=true dotenv -e .env.development -- node scripts/seed-demo-services.mjs",
    "functions:serve": "npm --prefix functions run serve",
    "functions:build": "npm --prefix functions run build"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@stripe/stripe-react-native": "0.50.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^11.2.0",
    "geofire-common": "^6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
